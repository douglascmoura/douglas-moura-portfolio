# ==========================================
# 3. CSP RELAXADA (APLICADA EXCLUSIVAMENTE AOS IFRAMES DOS GRAFICOS/MAPAS)
# ==========================================
/projetos_arquivos/*
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:;
